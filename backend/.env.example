# SpeechScope Environment Configuration
APP_ENV=development
DATABASE_URL=sqlite:///./speechscope.db

# Audio and Model Configuration
WHISPER_MODEL=base
MAX_AUDIO_DURATION=600
MAX_FILE_SIZE_BYTES=52428800

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional custom FFmpeg path (if not in system PATH)
# FFMPEG_PATH=C:/path/to/ffmpeg.exe

# Thresholds
PACE_DEVIATION_THRESHOLD=0.25
PITCH_VARIANCE_THRESHOLD=0.35
PAUSE_DEVIATION_THRESHOLD=0.40
ENERGY_DEVIATION_THRESHOLD=0.30
